# FormIQ PWA — environment variables
# Copy this to .env.local for local development

# Backend API base URL (no trailing slash)
VITE_API_URL=https://formiq-backend.up.railway.app

# Google OAuth 2.0 Client ID (Web application type)
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Sentry DSN — leave empty to disable error reporting locally
VITE_SENTRY_DSN=

# Varshyl Super Admin Access (VSAA) analytics webhook
VITE_VARSHYL_WEBHOOK_URL=https://hub.varshyl.com/webhook/formiq
VITE_VARSHYL_WEBHOOK_SECRET=
