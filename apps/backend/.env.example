# ──────────────────────────────────────────────────────────────────
# FormIQ Backend — Environment Variables
# Copy this file to .env for local development.
# All vars marked REQUIRED must be set before the server starts.
# ──────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development            # development | staging | production
PORT=3001                       # HTTP port

# Database (REQUIRED)
# Railway auto-populates DATABASE_URL when you add a Postgres plugin.
# Locally: postgresql://user:password@localhost:5432/formiq_dev
DATABASE_URL=postgresql://user:password@localhost:5432/formiq_dev

# JWT Secrets (REQUIRED — use long random strings, different per env)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME_with_64_random_hex_chars
JWT_REFRESH_SECRET=REPLACE_ME_with_different_64_random_hex_chars

# Google OAuth (REQUIRED for /auth/google — can leave blank to skip Google sign-in)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# CORS — frontend origin(s) allowed to call this API (REQUIRED)
# Comma-separated for multiple origins
# Staging: https://openpdf-studio-staging-staging.up.railway.app
# Production: https://app.snaphw.com
FRONTEND_ORIGIN=http://localhost:5173

# Logging level (optional — default: info)
LOG_LEVEL=info

# Email (Resend — used in COWORK-44 for magic links, not needed in COWORK-43)
# RESEND_API_KEY=re_xxxx
