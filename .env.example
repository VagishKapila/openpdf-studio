# FormIQ Monorepo — Environment Variables Reference
# ─────────────────────────────────────────────────
# Copy relevant sections to the appropriate service .env file.
# Never commit real values. All secrets live in Railway env vars or
# the project-level Cowork .env (not version-controlled).

# ── Deployment ────────────────────────────────────────────────────
# Railway account token — used by tools/scripts/deploy.sh to trigger
# production redeployments. Get from: railway.com → Account Settings → Tokens
RAILWAY_TOKEN=

# ── Frontend PWA (apps/pwa) ────────────────────────────────────────
# Backend API base URL (no trailing slash)
VITE_API_URL=https://formiq-backend.up.railway.app

# Google OAuth 2.0 Web Client ID
# Get from: console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Sentry DSN — leave empty to disable error reporting locally
VITE_SENTRY_DSN=

# Varshyl Super Admin Access webhook
VITE_VARSHYL_WEBHOOK_URL=https://hub.varshyl.com/webhook/formiq
VITE_VARSHYL_WEBHOOK_SECRET=

# ── Backend (apps/backend) ─────────────────────────────────────────
# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=

# JWT signing secrets — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Resend email API key (domain: mail.snaphw.com)
# Get from: resend.com → API Keys
RESEND_API_KEY=

# Google OAuth (server-side) — same project as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sentry (source maps upload) ───────────────────────────────────
# Get from: sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=
